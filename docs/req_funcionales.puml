@startuml Requerimientos_Funcionales_La_Libreta

title Especificación de Requerimientos Funcionales — La Libreta Digital

skinparam packageStyle rectangle
skinparam roundCorner 10
skinparam state {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontColor #1E3A8A
  ArrowColor #3B82F6
}

left to right direction

package "RF-01: Autenticación y Seguridad" {
  state "RF-01.1: Inicio de sesión por Magic Link (OTP)" as RF_1_1
  state "RF-01.2: Aislamiento multiusuario por políticas RLS" as RF_1_2
  state "RF-01.3: Cierre de sesión y limpieza de caché local" as RF_1_3
}

package "RF-02: Gestión de Clientes" {
  state "RF-02.1: Registro de clientes con Cédula y Teléfono" as RF_2_1
  state "RF-02.2: Modificación y baja de clientes" as RF_2_2
  state "RF-02.3: Búsqueda dinámica de clientes por texto" as RF_2_3
  state "RF-02.4: Cálculo automático de saldo pendiente" as RF_2_4
}

package "RF-03: Gestión de Préstamos / Fiados" {
  state "RF-03.1: Registro de fiado con carrito de compras" as RF_3_1
  state "RF-03.2: Registro alternativo de producto manual (sin stock)" as RF_3_2
  state "RF-03.3: Configuración de fecha y abono inicial" as RF_3_3
  state "RF-03.4: Asignación de días sugeridos de pago" as RF_3_4
  state "RF-03.5: Devolución de préstamos con retorno de stock y abonos" as RF_3_5
}

package "RF-04: Gestión de Abonos" {
  state "RF-04.1: Registro de abonos parciales o totales" as RF_4_1
  state "RF-04.2: Actualización de estado de préstamo a 'pagado' auto" as RF_4_2
  state "RF-04.3: Registro histórico contable de cada ingreso/egreso" as RF_4_3
}

package "RF-05: Gestión de Inventario" {
  state "RF-05.1: Registro de productos con precio, stock e imagen" as RF_05_1
  state "RF-05.2: Creación de categorías con colores distintivos" as RF_05_2
  state "RF-05.3: Validación de disponibilidad de stock al fiar" as RF_05_3
  state "RF-05.4: Actualización en vivo del valor total del inventario" as RF_05_4
}

package "RF-06: Panel de Control (Dashboard)" {
  state "RF-06.1: Visualización en tiempo real de 4 indicadores clave" as RF_06_1
  state "RF-06.2: Historial contable desglosado al clickear en Recaudación" as RF_06_2
  state "RF-06.3: Listado cronológico de últimas transacciones" as RF_06_3
}

package "RF-07: Validación en Tiempo Real" {
  state "RF-07.1: Restricción de caracteres especiales y letras en montos" as RF_07_1
  state "RF-07.2: Validación de cédula (7-10) y celular (10 dígitos)" as RF_07_2
  state "RF-07.3: Nombre y descripción limitados por longitud máxima" as RF_07_3
}

@enduml

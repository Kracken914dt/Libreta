@startuml Requerimientos_No_Funcionales_La_Libreta

title Especificación de Requerimientos No Funcionales — La Libreta Digital

skinparam packageStyle rectangle
skinparam roundCorner 10
skinparam state {
  BackgroundColor #FEF2F2
  BorderColor #EF4444
  FontColor #7F1D1D
  ArrowColor #EF4444
}

left to right direction

package "RNF-01: Usabilidad y UI" {
  state "RNF-01.1: Soporte para Tema Oscuro y Claro" as RNF_1_1
  state "RNF-01.2: Interfaz responsiva adaptada a móviles (mobile-first)" as RNF_1_2
  state "RNF-01.3: Diálogos premium integrados (evitando alert/confirm nativos)" as RNF_1_3
  state "RNF-01.4: Animaciones suaves de transición (<300ms)" as RNF_1_4
}

package "RNF-02: Rendimiento" {
  state "RNF-02.1: Carga y refresco silencioso en segundo plano sin loaders intrusivos" as RNF_2_1
  state "RNF-02.2: Respuestas inmediatas en búsquedas por filtrado local de estados" as RNF_2_2
  state "RNF-02.3: Optimización del peso del bundle (<300KB gzip)" as RNF_2_3
}

package "RNF-03: Seguridad y Privacidad" {
  state "RNF-03.1: Autenticación por correo segura sin persistencia de contraseña" as RNF_3_1
  state "RNF-03.2: Row Level Security (RLS) activo a nivel de motor de base de datos" as RNF_3_2
  state "RNF-03.3: Borrado completo del estado de negocio en frontend al desautenticar" as RNF_3_3
}

package "RNF-04: Portabilidad y Compatibilidad" {
  state "RNF-04.1: Ejecución fluida en navegadores modernos (Chrome, Safari, Edge, Firefox)" as RNF_4_1
  state "RNF-04.2: PWA ready / Accesible desde cualquier sistema operativo móvil" as RNF_4_2
}

package "RNF-05: Mantenibilidad y Escalabilidad" {
  state "RNF-05.1: Separación clara de componentes de UI y contexto global" as RNF_5_1
  state "RNF-05.2: Centralización de reglas de validación en utils/validation" as RNF_5_2
  state "RNF-05.3: Base de datos estructurada con índices para búsquedas rápidas" as RNF_5_3
}

@enduml
